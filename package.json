{
  "name": "anonymo",
  "productName": "Anonymo",
  "version": "0.1.0",
  "description": "Offline anonymizácia PDF, Word a Excel dokumentov pred použitím v ChatGPT alebo Claude.",
  "author": "Shanoon",
  "license": "AGPL-3.0-or-later",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/patch-dev-electron.cjs && electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch-assets": "node scripts/fetch-assets.mjs",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "e2e": "electron-vite build && node tests/e2e/smoke.mjs",
    "make-icon": "node scripts/make-icon.mjs",
    "postinstall": "node scripts/patch-dev-electron.cjs",
    "build:store": "npm run build && electron-builder --win appx --x64"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "clsx": "^2.1.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.70.0",
    "playwright": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "jszip": "^3.10.2",
    "mupdf": "1.28",
    "tesseract.js": "^7.0.0"
  }
}
